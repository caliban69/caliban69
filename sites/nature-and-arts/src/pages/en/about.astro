---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export const prerender = true;

const t = useTranslations('en');
---

<BaseLayout title={t('about.heading')} description={t('home.sustainability.body')}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="inline-block rounded border border-sand-400/40 bg-ink-900 px-3 py-1 text-xs text-sand-300">
      {t('trip.sampleContentNotice')}
    </p>
    <h1 class="mt-4 font-display text-3xl text-paper-50">{t('about.heading')}</h1>

    <div class="mt-10">
      <h2 class="font-display text-xl text-terracotta-400">{t('about.credibility.heading')}</h2>
      <p class="mt-3 text-stone-400">
        Cartacuba Nature & Arts is the parent Cartacuba company's arts and academic tour brand,
        built around personal relationships with Havana's working artists, musicians, and
        cultural venues — not a standard city tour with a stop at a gallery gift shop.
      </p>
      <p class="mt-3 text-sm text-stone-500">
        [Sample placeholder bio — Fred to provide the operator's real biography, credentials, and
        photo before launch.]
      </p>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-xl text-terracotta-400">{t('about.sustainability.heading')}</h2>
      <p class="mt-3 text-stone-400">
        We keep groups small and work directly with the artists, musicians, and independent
        venues themselves, rather than routing bookings through agencies or state tour operators
        — so a booking supports the person whose work or performance you came for.
      </p>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-xl text-terracotta-400">{t('about.ecotourism.heading')}</h2>
      <p class="mt-3 text-stone-400">
        Every experience is capped at a handful of guests — the kind of access, pace, and
        conversation that only happens in a small room, not on a bus.
      </p>
      <p class="mt-3 text-sm text-stone-500">
        [Sample placeholder — confirm final group-size caps and any named-artist participation
        agreements with Fred before launch.]
      </p>
    </div>
  </section>
</BaseLayout>
