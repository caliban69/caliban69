---
import { languages, type Locale } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translatePath = useTranslatedPath(locale);
const currentPath = Astro.url.pathname;
---

<div class="flex items-center gap-2 text-sm" aria-label="Language switcher">
  {
    Object.entries(languages).map(([code, label], i) => (
      <Fragment>
        {i > 0 && <span class="text-ink-600" aria-hidden="true">
          /
        </span>}
        <a
          href={translatePath(currentPath, code as Locale)}
          class="text-paper-100 hover:text-terracotta-400 aria-[current=true]:text-terracotta-400 aria-[current=true]:font-medium"
          aria-current={locale === code ? 'true' : undefined}
          hreflang={code}
        >
          {label}
        </a>
      </Fragment>
    ))
  }
</div>
