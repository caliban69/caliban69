---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import TripCard from './TripCard.astro';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const trips = await getCollection('trips', ({ id }) => id.startsWith(`${locale}/`));
// Nature & Arts currently only offers single-day experiences, so (unlike
// the source template) featured picks the first two trips generically
// rather than one daytrip + one multiday.
const [featuredFirst, featuredSecond] = trips;
---

<section class="relative overflow-hidden border-b border-ink-700 bg-ink-950 px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-widest text-sand-300">{t('home.hero.eyebrow')}</p>
    <h1 class="mt-6 font-display text-4xl text-paper-50 sm:text-6xl">{t('brand.name')}</h1>
    <p class="mt-4 text-lg text-stone-400">{t('brand.motto')}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={translatePath('/trips/')}
        class="rounded bg-terracotta-600 px-6 py-3 text-sm font-medium text-paper-50 hover:bg-terracotta-700"
      >
        {t('home.hero.cta')}
      </a>
      <a
        href="#sustainability"
        class="rounded border border-ink-600 px-6 py-3 text-sm text-paper-100 hover:border-sand-300"
      >
        {t('home.hero.ctaSecondary')}
      </a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-section-sm sm:px-6">
  <h2 class="font-display text-2xl text-paper-50">{t('home.valueProps.heading')}</h2>
  <div class="mt-10 grid gap-10 sm:grid-cols-3">
    <div>
      <h3 class="font-display text-lg text-terracotta-400">{t('home.valueProps.expertise.title')}</h3>
      <p class="mt-3 text-sm text-stone-400">{t('home.valueProps.expertise.body')}</p>
    </div>
    <div>
      <h3 class="font-display text-lg text-terracotta-400">{t('home.valueProps.community.title')}</h3>
      <p class="mt-3 text-sm text-stone-400">{t('home.valueProps.community.body')}</p>
    </div>
    <div>
      <h3 class="font-display text-lg text-terracotta-400">{t('home.valueProps.standards.title')}</h3>
      <p class="mt-3 text-sm text-stone-400">{t('home.valueProps.standards.body')}</p>
    </div>
  </div>
</section>

<section id="sustainability" class="border-y border-ink-700 bg-ink-900">
  <div class="mx-auto max-w-4xl px-4 py-section-sm text-center sm:px-6">
    <h2 class="font-display text-2xl text-paper-50">{t('home.sustainability.heading')}</h2>
    <p class="mt-4 text-stone-400">{t('home.sustainability.body')}</p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-section-sm sm:px-6">
  <h2 class="font-display text-2xl text-paper-50">{t('home.featured.heading')}</h2>
  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {featuredFirst && <TripCard trip={featuredFirst} />}
    {featuredSecond && <TripCard trip={featuredSecond} />}
  </div>
</section>

<section class="border-t border-ink-700 bg-ink-900">
  <div class="mx-auto max-w-6xl px-4 py-section-sm sm:px-6">
    <h2 class="font-display text-2xl text-paper-50">{t('home.trust.heading')}</h2>
    <ul class="mt-8 grid gap-6 text-sm text-paper-100 sm:grid-cols-3">
      <li class="rounded border border-ink-700 bg-ink-950 p-5">{t('home.trust.phd')}</li>
      <li class="rounded border border-ink-700 bg-ink-950 p-5">{t('home.trust.ecotourism')}</li>
      <li class="rounded border border-ink-700 bg-ink-950 p-5">{t('home.trust.community')}</li>
    </ul>
  </div>
</section>
