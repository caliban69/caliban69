---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  trip: CollectionEntry<'trips'>;
}
const { trip } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-2">
  <div>
    <h2 class="font-display text-xl text-paper-50">{t('trip.highlights')}</h2>
    <ul class="mt-4 flex flex-col gap-2 text-sm text-paper-100">
      {
        trip.data.highlights.map((item) => (
          <li class="flex gap-2">
            <span class="text-terracotta-400" aria-hidden="true">
              •
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="grid gap-8 sm:grid-cols-2">
    <div>
      <h2 class="font-display text-xl text-paper-50">{t('trip.included')}</h2>
      <ul class="mt-4 flex flex-col gap-2 text-sm text-paper-100">
        {
          trip.data.included.map((item) => (
            <li class="flex gap-2">
              <span class="text-olive-400" aria-hidden="true">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="font-display text-xl text-paper-50">{t('trip.excluded')}</h2>
      <ul class="mt-4 flex flex-col gap-2 text-sm text-stone-400">
        {
          trip.data.excluded.map((item) => (
            <li class="flex gap-2">
              <span aria-hidden="true">✕</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<div class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
  <h2 class="font-display text-xl text-paper-50">{t('trip.cancellationPolicy')}</h2>
  <p class="mt-3 max-w-3xl text-sm text-stone-400">{trip.data.cancellationPolicy}</p>
</div>
