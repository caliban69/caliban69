---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-700 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-display text-base text-paper-50">{t('footer.legalName')}</p>
        <p class="mt-1 text-sm text-sand-300">{t('brand.motto')}</p>
        <p class="mt-4 text-sm text-stone-400">{t('footer.address')}</p>
        <a
          href={`mailto:${t('footer.email')}`}
          class="mt-1 block text-sm text-stone-400 hover:text-terracotta-400"
        >
          {t('footer.email')}
        </a>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
        <a href={translatePath('/trips/')} class="text-paper-100 hover:text-terracotta-400"
          >{t('nav.trips')}</a
        >
        <a href={translatePath('/gallery/')} class="text-paper-100 hover:text-terracotta-400"
          >{t('nav.gallery')}</a
        >
        <a href={translatePath('/about/')} class="text-paper-100 hover:text-terracotta-400"
          >{t('nav.about')}</a
        >
        <a href={translatePath('/contact/')} class="text-paper-100 hover:text-terracotta-400"
          >{t('nav.contact')}</a
        >
      </nav>

      <nav aria-label="Legal" class="flex flex-col gap-2 text-sm">
        <a href={translatePath('/privacy/')} class="text-stone-400 hover:text-terracotta-400"
          >{t('footer.privacy')}</a
        >
        <a href={translatePath('/cookies/')} class="text-stone-400 hover:text-terracotta-400"
          >{t('footer.cookies')}</a
        >
        <a href="/sitemap-index.xml" class="text-stone-400 hover:text-terracotta-400"
          >{t('footer.sitemap')}</a
        >
      </nav>
    </div>

    <p class="mt-10 text-xs text-stone-500">
      &copy; {year} {t('footer.legalName')}. {t('footer.rights')}
    </p>
  </div>
</footer>
