# Copy to .env for local dev. In production these are set as Cloudflare
# Pages secrets (Workers secret store) — never committed, never in client bundles.

# --- Email delivery (Resend) ---
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=info@cartacubatours.example

# --- Cloudflare Turnstile (contact + booking-inquiry form bot mitigation) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stripe (Phase 2 — daytrip checkout; test-mode placeholder only for now) ---
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_DAYTRIP_PRICE_ID=

# --- Checkfront (Phase 2 — multiday tour booking widget; not yet selected/confirmed) ---
PUBLIC_CHECKFRONT_HOST=
PUBLIC_CHECKFRONT_WIDGET_ID=

# --- Site ---
PUBLIC_SITE_URL=https://www.cartacubatours.example
